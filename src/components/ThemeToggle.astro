---
import ModeIcon from './ModeIcon.astro';

interface Props {
  label?: string;
}

const { label = 'Color mode' } = Astro.props;
const modes: [RvdMode, string][] = [
  ['light', 'Light'],
  ['dark', 'Dark'],
  ['system', 'System'],
];
// ponytail: random ids so tooltips pair with their radio when several toggles share a page.
const id = `rvd-mode-${Math.random().toString(36).slice(2, 8)}`;
---
<wa-radio-group
  class="rvd-theme-toggle"
  label={label}
  orientation="horizontal"
  size="s"
  value="system"
  data-rvd-theme-toggle
>
  {modes.map(([value, name]) => (
    <wa-radio id={`${id}-${value}`} appearance="button" value={value}>
      <ModeIcon mode={value} />
      <span class="sr-only">{name}</span>
    </wa-radio>
  ))}
</wa-radio-group>
{modes.map(([value, name]) => <wa-tooltip for={`${id}-${value}`}>{name}</wa-tooltip>)}

<script>
  type RadioGroup = HTMLElement & { value: string | null };

  for (const group of document.querySelectorAll<RadioGroup>('[data-rvd-theme-toggle]')) {
    group.value = window.rvd.getMode();
    group.addEventListener('change', () => {
      if (group.value) window.rvd.setMode(group.value as RvdMode);
    });
    document.addEventListener('rvd:change', (event) => {
      if (group.value !== event.detail.mode) group.value = event.detail.mode;
    });
  }
</script>

<style>
  @layer components {
    .rvd-theme-toggle::part(form-control-label) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .rvd-theme-toggle::part(form-control-input) {
      flex-wrap: nowrap;
      gap: 2px;
      padding: 3px;
      border: 1px solid var(--rvd-line);
      border-radius: var(--rvd-radius-md);
    }

    /* Tailwind's preflight zeroes padding on every element, which beats WA's
       :host padding, so the segment padding is set here. */
    .rvd-theme-toggle wa-radio {
      margin: 0;
      padding: 5px 7px;
      border-radius: var(--rvd-radius-sm);
      color: var(--rvd-muted);
    }

    .rvd-theme-toggle wa-radio svg {
      display: block;
    }

    .rvd-theme-toggle wa-radio:state(checked) {
      background-color: var(--rvd-selected);
      color: var(--rvd-ink);
    }
  }
</style>
