---
interface Props {
  first: string;
  last: string;
  href?: string;
}

const { first, last, href = '/' } = Astro.props;
---
<a class="rvd-wordmark type-wordmark" href={href}>{first}<span class="rvd-wordmark__slash">/</span>{last}</a>

<style>
  @layer components {
    .rvd-wordmark {
      text-decoration: none;
    }

    .rvd-wordmark__slash {
      color: var(--rvd-accent);
    }
  }
</style>
