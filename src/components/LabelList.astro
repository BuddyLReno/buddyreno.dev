---
interface Props {
  closed?: boolean;
  /** `ul` for plain lists of unlabeled `LabelRow`s; `dl` (default) for labeled rows. */
  as?: 'dl' | 'ul';
}

const { closed = true, as: Tag = 'dl' } = Astro.props;
---
<Tag class="rvd-label-list" data-rvd-closed={String(closed)}><slot /></Tag>

<style>
  @layer components {
    .rvd-label-list {
      display: flex;
      flex-direction: column;
      margin: 0;
    }

    .rvd-label-list[data-rvd-closed='true'] {
      border-bottom: 1px solid var(--rvd-line);
    }
  }
</style>
