---
import Button from './Button.astro';

interface Props {
  email: string;
}

const { email } = Astro.props;
---
<span class="rvd-copy-email" data-rvd-copy-email>
  <wa-copy-button
    value={email}
    tooltip="none"
    feedback-duration="1600"
    success-label="Email address copied"
    error-label="Could not copy the email address"
  >
    <Button>
      {email}
      {/* Label and icons share one grid cell, so the button never changes width. */}
      <span slot="sub" class="rvd-copy-email__label" data-rvd-copy-label data-state="idle">
        <span class="rvd-copy-email__text">Copy</span>
        <svg class="rvd-copy-email__icon" data-rvd-copy-icon="copied" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="m8 12.5 2.5 2.5L16 9.5" /></svg>
        <svg class="rvd-copy-email__icon" data-rvd-copy-icon="failed" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="m9 9 6 6m0-6-6 6" /></svg>
      </span>
    </Button>
  </wa-copy-button>
</span>

<script>
  // wa-copy-button announces success/failure; the icons are visual only.
  for (const root of document.querySelectorAll<HTMLElement>('[data-rvd-copy-email]')) {
    const label = root.querySelector<HTMLElement>('[data-rvd-copy-label]');
    const copyButton = root.querySelector('wa-copy-button');
    const resetMs = Number(copyButton?.getAttribute('feedback-duration')) || 1600;
    let timer: ReturnType<typeof setTimeout> | undefined;

    const show = (state: 'copied' | 'failed') => {
      if (!label) return;
      label.dataset.state = state;
      clearTimeout(timer);
      timer = setTimeout(() => {
        label.dataset.state = 'idle';
      }, resetMs);
    };

    root.addEventListener('wa-copy', () => show('copied'));
    root.addEventListener('wa-error', () => show('failed'));
  }
</script>

<style>
  @layer components {
    .rvd-copy-email__label {
      display: inline-grid;
      place-items: center;
    }

    .rvd-copy-email__label > * {
      grid-area: 1 / 1;
    }

    .rvd-copy-email__icon {
      width: 1.6em;
      height: 1.6em;
      visibility: hidden;
    }

    .rvd-copy-email__label:not([data-state='idle']) .rvd-copy-email__text,
    .rvd-copy-email__label[data-state='idle'] .rvd-copy-email__icon {
      visibility: hidden;
    }

    .rvd-copy-email__label[data-state='copied'] [data-rvd-copy-icon='copied'],
    .rvd-copy-email__label[data-state='failed'] [data-rvd-copy-icon='failed'] {
      visibility: visible;
    }
  }
</style>
