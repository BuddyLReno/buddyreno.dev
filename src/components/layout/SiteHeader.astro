---
import AppearanceMenu from '../AppearanceMenu.astro';
import Wordmark from '../Wordmark.astro';
import Container from './Container.astro';

interface Props {
  /** Show the appearance menu (mode + palette). Off where a page provides its own (e.g. the styleguide toolbar). */
  toggle?: boolean;
}

const { toggle = true } = Astro.props;
---
<header class="rvd-site-header">
  <Container>
    <div class="rvd-site-header__row">
      <Wordmark first="Buddy" last="Reno" />
      {toggle && <AppearanceMenu />}
    </div>
  </Container>
</header>

<style>
  @layer components {
    .rvd-site-header__row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding-block: 28px;
    }
  }
</style>
