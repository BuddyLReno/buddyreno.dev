---
import ThemeToggle from '../ThemeToggle.astro';

const links = [
  ['color', 'Color'],
  ['type', 'Type'],
  ['scale', 'Scale'],
  ['tones', 'Tones'],
  ['components', 'Components'],
  ['web-awesome', 'Web Awesome'],
  ['prose', 'Prose'],
];
const themes = Object.keys(import.meta.glob('../../styles/themes/*.css'))
  .map((path) => path.split('/').pop()!.replace(/\.css$/, ''))
  .sort((a, b) => (a === 'teal-amber' ? -1 : b === 'teal-amber' ? 1 : a.localeCompare(b)));
---
<nav class="rvd-sg-toolbar" aria-label="Styleguide">
  <ul class="rvd-sg-toolbar__links type-label-sm">
    {links.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
  </ul>
  <div class="rvd-sg-toolbar__controls">
    <ThemeToggle />
    <label class="rvd-sg-toolbar__theme type-label-sm">
      <span class="rvd-sg-toolbar__theme-text">Theme</span>
      <select data-rvd-theme-select>
        {themes.map((theme) => <option value={theme}>{theme}</option>)}
      </select>
    </label>
  </div>
</nav>

<style>
  @layer components {
    .rvd-sg-toolbar {
      position: sticky;
      top: 0;
      z-index: 10;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px 20px;
      padding: 10px var(--rvd-gutter);
      border-block: 1px solid var(--rvd-line);
      background: var(--rvd-bg);
    }

    .rvd-sg-toolbar__links {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 16px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .rvd-sg-toolbar__controls {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      gap: 24px;
    }

    /* Phones: links scroll sideways on one row; controls share the second. */
    @media (max-width: 640px) {
      .rvd-sg-toolbar__links {
        flex-wrap: nowrap;
        width: 100%;
        overflow-x: auto;
        padding-bottom: 4px; /* room for link underlines inside the scroll box */
        scrollbar-width: none;
        white-space: nowrap;
      }

      .rvd-sg-toolbar__theme-text {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
    }

    .rvd-sg-toolbar__theme {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--rvd-muted);
    }

    .rvd-sg-toolbar__theme select {
      padding: 4px 8px;
      border: 1px solid var(--rvd-line);
      border-radius: var(--rvd-radius-sm);
      background: var(--rvd-surface);
      color: var(--rvd-ink);
      font: inherit;
    }
  }
</style>
