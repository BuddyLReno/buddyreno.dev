---
import AppearanceMenu from '../AppearanceMenu.astro';

const links = [
  ['color', 'Color'],
  ['type', 'Type'],
  ['scale', 'Scale'],
  ['tones', 'Tones'],
  ['components', 'Components'],
  ['web-awesome', 'Web Awesome'],
  ['prose', 'Prose'],
];
---
<nav class="rvd-sg-toolbar" aria-label="Styleguide">
  <ul class="rvd-sg-toolbar__links type-label-sm">
    {links.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
  </ul>
  <div class="rvd-sg-toolbar__controls">
    <AppearanceMenu />
  </div>
</nav>

<style>
  @layer components {
    .rvd-sg-toolbar {
      position: sticky;
      top: 0;
      z-index: 10;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px 20px;
      padding: 10px var(--rvd-gutter);
      border-block: 1px solid var(--rvd-line);
      background: var(--rvd-bg);
    }

    .rvd-sg-toolbar__links {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 16px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .rvd-sg-toolbar__controls {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      gap: 24px;
    }

    /* Phones: links scroll sideways on one row; controls share the second. */
    @media (max-width: 640px) {
      .rvd-sg-toolbar__links {
        flex-wrap: nowrap;
        width: 100%;
        overflow-x: auto;
        padding-bottom: 4px; /* room for link underlines inside the scroll box */
        scrollbar-width: none;
        white-space: nowrap;
      }
    }
  }
</style>
